{
  "author": "Manuel Peliz",
  "license": "Apache-2.0",
  "name": "@mpeliz/gtplweb",
  "version": "2.1.0",
  "description": "Web component framework built on top of GTPL with AOT compilation.",
  "keywords": [
    "gtpl",
    "framework",
    "web-components",
    "aot",
    "typescript"
  ],
  "homepage": "https://www.npmjs.com/package/@mpeliz/gtplweb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garag-lib/GTPLWeb.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "type": "module",
  "main": "./dist/gtplweb.cjs",
  "module": "./dist/gtplweb.esm.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "tools/aot-prebuild.js",
    "tools/app-build.js",
    "tools/build-paths.js",
    "tools/init-app.js",
    "tools/starter-bundle.generated.js",
    "tools/starter-template",
    "tools/build-starter-bundle.js",
    "tools/init-project.sh",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CITATION.cff"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gtplweb.esm.js",
      "require": "./dist/gtplweb.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.esm.js",
      "require": "./dist/runtime.cjs"
    }
  },
  "scripts": {
    "clean": "rm -rf dist src-aot",
    "build:starter-bundle": "node tools/build-starter-bundle.js",
    "aot": "node tools/aot-prebuild.js",
    "test": "npm run build:structured && npm run build:docs && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:package": "node --test tests/runtime-entry.test.mjs && node --test --test-name-pattern='the require export' tests/tooling.test.mjs",
    "prepublishOnly": "npm run build:starter-bundle && npm run typecheck && npm run build:bundle",
    "build:bundle": "npm run clean && npm run aot && rollup -c pro.rollup.config.mjs && npm run test:package",
    "build:structured": "npm run clean && npm run aot && rollup -c rollup.config.mjs",
    "build:docs": "node tools/build-docs.mjs",
    "test:docs": "npm run build:docs && node --test tests/docs.test.mjs"
  },
  "bin": {
    "gtpl-aot": "tools/aot-prebuild.js",
    "gtpl-app-build": "tools/app-build.js",
    "gtpl-init": "tools/init-app.js"
  },
  "dependencies": {
    "@mpeliz/gtpl": "github:garag-lib/GTPL#v3.1.0",
    "esbuild": "^0.28.1",
    "glob": "^13.0.6",
    "jsdom": "^27.0.1",
    "sass": "^1.93.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.9.1",
    "rollup": "^4.9.6",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.2.3"
  },
  "gtplweb": {
    "compiler": "optimized",
    "methodAliases": true
  }
}
